# Clé secrète Flask — sessions sécurisées + protection CSRF (OBLIGATOIRE)
# Générez-en une avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplacez_par_une_cle_aleatoire

# Clé API Hugging Face (obligatoire pour le chat IA)
HF_TOKEN=votre_cle_huggingface_ici

# Modèle de chat (optionnel)
HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
# HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Paramètres RAG (optionnel)
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
MAX_UPLOAD_MB=10
